{
  "manifest_version": 3,
  "name": "ScanMyCreds — Breach Detector",
  "version": "1.0.0",
  "description": "Instantly check if your email has been in a data breach. Get warned on login pages automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "ScanMyCreds"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.scanmycreds.com/*",
    "https://api.pwnedpasswords.com/*"
  ]
}